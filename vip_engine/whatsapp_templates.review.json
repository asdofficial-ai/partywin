        {
          "type": "BUTTONS",
          "buttons": [
            {
              "type": "URL",
              "text": "View Event",
              "url": "https://partywin.ng/e/{{1}}",
              "example": [
                "event-demo-001"
              ]
            }
          ]
        }
      ]
    },
